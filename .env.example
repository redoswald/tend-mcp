# Server-side
SUPABASE_URL=                    # Supabase project URL (shared Done Intentionally project)
SUPABASE_SERVICE_KEY=            # Service role key — Tend tables have no RLS; app-level userId filtering enforces isolation
SUPABASE_ANON_KEY=               # Anon key — used only to validate bearer JWTs (auth.getUser)
OAUTH_CODE_SECRET=               # Secret for encrypting OAuth authorization codes

# Browser-side (authorize page sign-in)
NEXT_PUBLIC_SUPABASE_URL=        # Same Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Same anon key
